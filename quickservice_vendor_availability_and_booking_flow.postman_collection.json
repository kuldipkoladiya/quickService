{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d",
		"name": "QuickService - Vendor Availability & Booking Flow",
		"description": "Production-ready APIs for Vendor Working Hours (Instant Visit vs Visit by Schedule toggles, Weekly Monday-Sunday schedule) and Customer View & Booking Flow (auto-detected bookingType, slot picker).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Vendor Working Hours & Availability",
			"item": [
				{
					"name": "Get My Availability / Working Hours (Vendor)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{vendor_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/v1/vendor/vendor-availability/my-availability",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"vendor",
								"vendor-availability",
								"my-availability"
							]
						}
					},
					"response": []
				},
				{
					"name": "Save Working Hours: Instant Visit ON (Vendor UI)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{vendor_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"storeStatus\": \"online\",\n    \"bookingOption\": \"instant\",\n    \"weeklySchedule\": [\n        { \"day\": \"monday\", \"isOpen\": true },\n        { \"day\": \"tuesday\", \"isOpen\": true },\n        { \"day\": \"wednesday\", \"isOpen\": true },\n        { \"day\": \"thursday\", \"isOpen\": true },\n        { \"day\": \"friday\", \"isOpen\": true },\n        { \"day\": \"saturday\", \"isOpen\": true },\n        { \"day\": \"sunday\", \"isOpen\": false }\n    ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/vendor/vendor-availability/my-availability",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"vendor",
								"vendor-availability",
								"my-availability"
							]
						}
					},
					"response": []
				},
				{
					"name": "Save Working Hours: Visit by Schedule ON (Vendor UI)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{vendor_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"storeStatus\": \"online\",\n    \"bookingOption\": \"schedule\",\n    \"weeklySchedule\": [\n        { \"day\": \"monday\", \"isOpen\": true },\n        { \"day\": \"tuesday\", \"isOpen\": true },\n        { \"day\": \"wednesday\", \"isOpen\": true },\n        { \"day\": \"thursday\", \"isOpen\": true },\n        { \"day\": \"friday\", \"isOpen\": true },\n        { \"day\": \"saturday\", \"isOpen\": true },\n        { \"day\": \"sunday\", \"isOpen\": false }\n    ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/vendor/vendor-availability/my-availability",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"vendor",
								"vendor-availability",
								"my-availability"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Customer Service View & Slots",
			"item": [
				{
					"name": "Get Vendor Services By Category (Customer View)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{customer_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/v1/customer/vendor-service/category/{{categoryId}}?page=1&limit=10",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"customer",
								"vendor-service",
								"category",
								"{{categoryId}}"
							],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Get Available Days & Time Slots (Customer Slot UI)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{customer_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/v1/customer/vendor-availability/slots/{{vendorId}}?days=7",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"customer",
								"vendor-availability",
								"slots",
								"{{vendorId}}"
							],
							"query": [
								{
									"key": "days",
									"value": "7"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Get Vendor Availability by Vendor ID (Customer)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{customer_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/v1/customer/vendor-availability/vendor/{{vendorId}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"customer",
								"vendor-availability",
								"vendor",
								"{{vendorId}}"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Customer Booking Flow (Auto BE Handled)",
			"item": [
				{
					"name": "Create Instant Visit Booking (Customer)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{customer_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"vendorId\": \"{{vendorId}}\",\n    \"vendorServiceId\": \"{{vendorServiceId}}\",\n    \"addressId\": \"{{addressId}}\",\n    \"notes\": \"Instant service\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/customer/bookings",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"customer",
								"bookings"
							]
						}
					},
					"response": []
				},
				{
					"name": "Create Scheduled Visit Booking (Customer)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{customer_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"vendorId\": \"{{vendorId}}\",\n    \"vendorServiceId\": \"{{vendorServiceId}}\",\n    \"addressId\": \"{{addressId}}\",\n    \"bookingDate\": \"2026-08-18\",\n    \"timeSlot\": \"9 am - 12 pm\",\n    \"notes\": \"Appointment booked via schedule\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/customer/bookings",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"customer",
								"bookings"
							]
						}
					},
					"response": []
				}
			]
		}
	]
}
